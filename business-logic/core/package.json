{
  "name": "@mytaptrack/business-logic-core",
  "version": "1.0.0",
  "description": "Core business logic interfaces, types, and error classes for MyTapTrack",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js",
      "require": "./dist/interfaces/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js",
      "require": "./dist/errors/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "require": "./dist/config/index.js"
    },
    "./lambda": {
      "types": "./dist/lambda/index.d.ts",
      "import": "./dist/lambda/index.js",
      "require": "./dist/lambda/index.js"
    }
  },
  "scripts": {
    "build": "tsc -d",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mytaptrack/types": "file:../../types",
    "@mytaptrack/lib": "file:../../lib",
    "@aws-sdk/client-eventbridge": "^3.391.0",
    "@aws-sdk/client-secrets-manager": "^3.391.0",
    "@aws-sdk/client-ses": "^3.391.0",
    "amqplib": "^0.10.3",
    "uuid": "^9.0.0",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "@apollo/server": "^4.9.0",
    "graphql": "^16.8.0",
    "@graphql-tools/schema": "^10.0.0",
    "graphql-query-complexity": "^0.12.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "typescript": "^5.4.5",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/amqplib": "^0.10.1",
    "@types/uuid": "^9.0.0",
    "@types/express": "^4.17.17",
    "@types/compression": "^1.7.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/js-yaml": "^4.0.5",
    "ts-jest": "^29.1.1"
  },
  "peerDependencies": {
    "moment-timezone": "^0.5.45"
  },
  "author": "mytaptrack",
  "license": "UNLICENSED",
  "keywords": [],
  "type": "commonjs"
}
