{
  "name": "@mytaptrack/business-logic-user",
  "version": "1.0.0",
  "description": "User-specific business logic operations for MyTapTrack",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./operations": {
      "types": "./dist/operations/index.d.ts",
      "import": "./dist/operations/index.js",
      "require": "./dist/operations/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js",
      "require": "./dist/validation/index.js"
    }
  },
  "scripts": {
    "build": "tsc -d",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mytaptrack/business-logic-core": "file:../core",
    "@mytaptrack/types": "file:../types",
    "moment-timezone": "^0.5.45"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "typescript": "^5.4.5",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12"
  },
  "author": "mytaptrack",
  "license": ""
}