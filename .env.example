# Container Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Stage/Environment
STAGE=dev

# Local Development
NODE_ENV=development
USE_LOCAL=true

# RabitMQ Server
RABBITMQ_URL=amqp://mytaptrack:mytaptrack@localhost:5672

# REDIS Server
REDIS_HOST=localhost
REDIS_PORT=6379

# Security Tokens
JWT_SECRET=local-dev-secret-change-in-production
TOKEN_ENCRYPT_KEY=local-token-encryption-key-change-in-production

# Rest Server
REST_PORT=3000

# Graphql Server
GRAPHIQL_ENABLED=true
GRAPHQL_PORT=4000

# DynamoDB
DYNAMODB_ENDPOINT=http://localhost:8000
# NOTE: Table names here are for the local API server container.
# System tests override these with mytaptrack-local-* via system-tests/src/jest.setup.ts.
# Do not change these values to match the test overrides.
PrimaryTable=mytaptrack-primary
DataTable=mytaptrack-data
STRONGLY_CONSISTENT_READ=true

# App Configuration
appid=mytaptrack