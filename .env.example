# MyTapTrack Environment Variables
# Copy this file to .env and update with your actual values
# 
# ⚠️  SECURITY WARNING ⚠️
# Never commit .env files with real values to version control!

# Environment Configuration
NODE_ENV=development
STAGE=dev
AWS_REGION=us-west-2

# Database Configuration
DATABASE_PROVIDER=mongodb
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE=mytaptrack_dev

# For AWS/DynamoDB
DYNAMODB_REGION=us-west-2
DYNAMODB_PRIMARY_TABLE=mytaptrack-dev-primary
DYNAMODB_DATA_TABLE=mytaptrack-dev-data

# Message Broker Configuration
MESSAGE_BROKER_PROVIDER=rabbitmq
RABBITMQ_CONNECTION_STRING=amqp://localhost:5672
RABBITMQ_VHOST=mytaptrack_dev

# For AWS/EventBridge
EVENTBRIDGE_REGION=us-west-2
EVENTBRIDGE_EVENT_BUS=mytaptrack-dev-events

# Authentication Configuration
AUTH_PROVIDER=jwt
JWT_PUBLIC_KEY_PATH=./config/jwt-public.key
JWT_ISSUER=mytaptrack-dev
JWT_AUDIENCE=mytaptrack-api

# For AWS/Cognito
COGNITO_REGION=us-west-2
COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Cache Configuration
CACHE_PROVIDER=redis
REDIS_CONNECTION_STRING=redis://localhost:6379
REDIS_KEY_PREFIX=mtt:dev:

# Service Configuration
GRAPHQL_PORT=4000
REST_API_PORT=4501
DEVICE_API_PORT=4502

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=pretty
SERVICE_NAME=mytaptrack-dev
APP_VERSION=dev

# Secret Management
SECRET_PROVIDER=env

# Secrets (use your secret management system in production)
SECRET_DATABASE_PASSWORD=your-database-password
SECRET_JWT_PRIVATE_KEY=your-jwt-private-key
SECRET_ENCRYPTION_KEY=your-encryption-key
SECRET_API_KEY=your-api-key

# AWS Specific (for production)
ANDROID_SNS_ARN=arn:aws:sns:us-west-2:123456789012:android-push
IOS_SNS_ARN=arn:aws:sns:us-west-2:123456789012:ios-push
DOMAIN_NAME=mytaptrack.com
HOSTED_ZONE_ID=Z1234567890ABC

# Processing Configuration
BATCH_SIZE=5
RETRY_ATTEMPTS=2
RETRY_DELAY=3000
STUDENT_REMOVE_TIMEOUT=90000

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Tracing Configuration
TRACING_PROVIDER=jaeger