FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY api/package*.json ./
COPY api/tsconfig.json ./
COPY lib/package*.json ./lib/
COPY lib/tsconfig.json ./lib/
COPY types/package*.json ./types/
COPY types/tsconfig.json ./types/

# Install dependencies
RUN npm ci --only=production

# Copy source
COPY api/src/device ./src/device
COPY api/src/container ./src/container
COPY lib ./lib
COPY types ./types

EXPOSE 3001

CMD ["npm", "run", "device:start"]
