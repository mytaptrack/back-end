{
    "name": "mytaptrack-user-api",
    "version": "1.0.1",
    "scripts": {
        "start": "cdk deploy --watch --hotswap graphql",
        "deploy": "cdk deploy --all",
        "codebuild": "npx samtsc --deploy-only",
        "build": "cdk synth",
        "package": "npx samtsc --package",
        "prepackage-cdk": "rm -rf cdk.out",
        "package-cdk": "cdk deploy --no-execute --change-set-name pipeline-deployment --require-approval never",
        "start-cdk": "cdk deploy --watch --hotswap",
        "test": "vitest run --coverage",
        "typecheck": "tsc -p tsconfig.typecheck.json",
        "presetDebug": "npm uninstall @mytaptrack/types",
        "setDebug": "npm i ../../types ../../cdk",
        "unsetDebug": "npm uninstall @mytaptrack/types npm i @mytaptrack/types --save",
        "buildlibs": "cd ../types && tsc -d && cd ../lib && tsc -d",
        "stage-changeset": "cdk deploy --all --no-execute --change-set-name pipeline-deployment --require-approval never",
        "local-api": "npx ts-node src/start-api.ts",
        "container:start": "npx ts-node --transpile-only src/container/graphql-server.ts",
        "container:init-tables": "npx ts-node --transpile-only src/container/init-tables.ts",
        "device:start": "npx ts-node --transpile-only src/container/device-server.ts",
        "device:watch": "npx nodemon --watch src --ext ts --exec 'npx ts-node --transpile-only src/container/device-server.ts'",
        "rest:start": "npx ts-node --transpile-only src/container/rest-api-server.ts",
        "rest:watch": "npx nodemon --watch src --ext ts --exec 'npx ts-node --transpile-only src/container/rest-api-server.ts'",
        "graphql:start": "npx ts-node --transpile-only src/container/graphql-server.ts",
        "graphql:watch": "npx nodemon --watch src --ext ts --exec 'npx ts-node --transpile-only src/container/graphql-server.ts'",
        "rabbitmq:consumer": "npx ts-node --transpile-only src/container/rabbitmq-consumer.ts",
        "rabbitmq:watch": "npx nodemon --watch src --ext ts --exec 'npx ts-node --transpile-only src/container/rabbitmq-consumer.ts'",
        "start:all": "npx ts-node --transpile-only src/container/start-all.ts"
    },
    "dependencies": {
        "@aws-appsync/utils": "^2.1.1",
        "@aws-sdk/client-cognito-identity-provider": "^3.1161.0",
        "@aws-sdk/client-dynamodb": "^3.1161.0",
        "@aws-sdk/client-eventbridge": "^3.1161.0",
        "@aws-sdk/client-kms": "^3.1161.0",
        "@aws-sdk/client-lex-runtime-service": "^3.1161.0",
        "@aws-sdk/client-pinpoint": "^3.1161.0",
        "@aws-sdk/client-s3": "^3.1161.0",
        "@aws-sdk/client-secrets-manager": "^3.1161.0",
        "@aws-sdk/client-ses": "^3.1161.0",
        "@aws-sdk/client-sesv2": "^3.1161.0",
        "@aws-sdk/client-sfn": "^3.1161.0",
        "@aws-sdk/client-sms": "^3.879.0",
        "@aws-sdk/client-sns": "^3.1161.0",
        "@aws-sdk/client-sqs": "^3.1161.0",
        "@aws-sdk/client-ssm": "^3.1161.0",
        "@aws-sdk/lib-dynamodb": "^3.1161.0",
        "@aws-sdk/s3-request-presigner": "^3.1161.0",
        "@lumigo/tracer": "^1.111.2",
        "@mytaptrack/cdk": "file:../cdk",
        "@mytaptrack/get-ssl-certificate": "^2.3.4",
        "@mytaptrack/lib": "file:../lib",
        "@mytaptrack/stack-lib": "file:src/library",
        "@mytaptrack/types": "file:../types",
        "@types/js-yaml": "^4.0.9",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/passport-saml": "^1.1.7",
        "aws-sigv4-fetch": "^5.0.1",
        "body-parser": "^1.20.2",
        "crypto-ts": "^1.0.2",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "express-graphql": "^0.12.0",
        "graphql": "^14.7.0",
        "graphql-http": "^1.22.4",
        "graphql-request": "^6.1.0",
        "ioredis": "^5.8.2",
        "js-yaml": "^4.1.1",
        "jsonschema": "^1.4.0",
        "jsonwebtoken": "^9.0.3",
        "lodash": "^4.17.21",
        "moment-timezone": "^0.5.43",
        "passport-saml": "^3.2.4",
        "qrcode": "^1.5.4",
        "short-uuid": "^4.2.0",
        "source-map-support": "^0.5.16",
        "stripe": "^14.20.0",
        "tslib": "^2.6.2",
        "twilio": "^5.0.4",
        "uuid": "^8.3.2",
        "written-number": "^0.11.1",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/amqplib": "^0.10.1",
        "@types/aws-lambda": "^8.10.164",
        "@types/express": "^4.17.17",
        "@types/moment-timezone": "^0.5.30",
        "@types/node": "^24.0.0",
        "@vitest/coverage-v8": "^5.0.5",
        "amqplib": "^0.10.3",
        "aws-cdk-lib": "^2.275.0",
        "constructs": "^10.8.1",
        "nodemon": "^3.1.11",
        "ts-loader": "^9.2.6",
        "ts-node": "^10.9.1",
        "typescript": "^5.9.0",
        "url": "^0.11.0",
        "vitest": "^5.0.5"
    }
}
