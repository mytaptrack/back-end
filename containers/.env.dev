# MyTapTrack Docker Environment Configuration
# Copy this file to .env and customize for your environment

# Environment
NODE_ENV=production
APP_VERSION=1.0.0

# Database Passwords
MONGODB_PASSWORD=your_secure_mongodb_password_here
RABBITMQ_PASSWORD=your_secure_rabbitmq_password_here
REDIS_PASSWORD=your_secure_redis_password_here

# JWT Configuration
JWT_ISSUER=mytaptrack
JWT_AUDIENCE=mytaptrack-api

# CORS Configuration
CORS_ORIGINS=https://app.mytaptrack.com,https://admin.mytaptrack.com

# Logging
LOG_LEVEL=info

# Data Processor Configuration
BATCH_SIZE=10
RETRY_ATTEMPTS=3
RETRY_DELAY=5000

# Optional: External Authentication Provider
# AUTH_PROVIDER=keycloak
# KEYCLOAK_URL=http://keycloak:8080
# KEYCLOAK_REALM=mytaptrack
# KEYCLOAK_CLIENT_ID=mytaptrack-api
# KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret

# Optional: External Monitoring
# PROMETHEUS_ENABLED=true
# GRAFANA_ENABLED=true

# Optional: SSL Configuration
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem