{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "moduleResolution": "node",
    "allowJs": true,
    "noEmit": false,
    "baseUrl": "./",
    "types": ["node"],
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["shared/*"],
      "@logging/*": ["business-logic/core/src/logging/*"]
    }
  },
  "include": [
    "src/**/*",
    "shared/**/*",
    "business-logic/core/src/logging/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}