    },
    {
      "name": "user.events.retry",
      "vhost": "mytaptrack",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "mytaptrack.dlx",
        "x-dead-letter-routing-key": "user.events.failed",
        "x-message-ttl": 30000
      }
    },
    {
      "name": "student.events.retry",
