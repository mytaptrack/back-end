      "arguments": {
        "x-dead-letter-exchange": "mytaptrack.dlx",
        "x-dead-letter-routing-key": "device.events.failed",
        "x-message-ttl": 30000
      }
    }
  ],
  "exchanges": [
    {
      "name": "mytaptrack.events",
      "vhost": "mytaptrack",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "mytaptrack.dlx",
      "vhost": "mytaptrack",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "mytaptrack.retry",
      "vhost": "mytaptrack",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
