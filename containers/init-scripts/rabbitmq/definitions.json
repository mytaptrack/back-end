{
  "rabbit_version": "3.11.0",
  "rabbitmq_version": "3.11.0",
  "product_name": "RabbitMQ",
  "product_version": "3.11.0",
  "users": [
    {
      "name": "admin",
      "password_hash": "admin",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": "administrator"
    },
    {
      "name": "mytaptrack_app",
      "password_hash": "app_password",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": ""
    }
  ],
  "vhosts": [
    {
      "name": "mytaptrack"
    }
  ],
  "permissions": [
    {
      "user": "admin",
      "vhost": "mytaptrack",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    },
    {
      "user": "mytaptrack_app",
      "vhost": "mytaptrack",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "topic_permissions": [],
  "parameters": [],
  "global_parameters": [
    {
      "name": "cluster_name",
      "value": "mytaptrack-cluster"
    }
  ],
  "policies": [
    {
      "vhost": "mytaptrack",
      "name": "ha-all",
      "pattern": ".*",
      "apply-to": "all",
      "definition": {
        "ha-mode": "all",
        "ha-sync-mode": "automatic",
        "ha-sync-batch-size": 1
      },
      "priority": 0
    },
    {
      "vhost": "mytaptrack",
      "name": "retry-policy",
      "pattern": "\\.retry$",
      "apply-to": "queues",
      "definition": {
        "message-ttl": 30000,
        "max-length": 5000,
        "overflow": "drop-head"
      },
      "priority": 5
    },
    {
      "vhost": "mytaptrack",
      "name": "failed-queue-policy",
      "pattern": "\\.failed$",
      "apply-to": "queues",
      "definition": {
        "max-length": 10000,
        "overflow": "reject-publish"
      },
      "priority": 10
    }
  ],
  "queues": [
    {
      "name": "user.events",
      "vhost": "mytaptrack",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "mytaptrack.retry",
        "x-dead-letter-routing-key": "user.events.retry",
        "x-message-ttl": 3600000
      }
    },
    {
      "name": "student.events",
      "vhost": "mytaptrack",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "mytaptrack.retry",
        "x-dead-letter-routing-key": "student.events.retry",
        "x-message-ttl": 3600000
      }
    },
    {
      "name": "license.events",
      "vhost": "mytaptrack",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "mytaptrack.retry",
        "x-dead-letter-routing-key": "license.events.retry",
        "x-message-ttl": 3600000
      }
    },
    {
      "name": "report.events",
      "vhost": "mytaptrack",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "mytaptrack.retry",
        "x-dead-letter-routing-key": "report.events.retry",
        "x-message-ttl": 3600000
      }
    },
    {
      "name": "app.events",
      "vhost": "mytaptrack",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "mytaptrack.retry",
        "x-dead-letter-routing-key": "app.events.retry",
        "x-message-ttl": 3600000
      }
    },
    {
      "name": "device.events",
      "vhost": "mytaptrack",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "mytaptrack.retry",
        "x-dead-letter-routing-key": "device.events.retry",
        "x-message-ttl": 3600000
      }
    },
    {
      "name": "user.events.failed",
      "vhost": "mytaptrack",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "student.events.failed",
      "vhost": "mytaptrack",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
