/**
 * Integration tests for DAL abstraction layer
 */

import { Dal, DalBaseClass } from './dal';
import { CompatibleDal, CompatibleDalBaseClass } from './dal-compatibility';
import { AbstractedDal, AbstractedDalBaseClass } from './abstracted-dal';

describe('DAL Integration Tests', () => {
  describe('Enhanced Dal Class', () => {
    let dal: Dal;

    beforeEach(() => {
      dal = new Dal('primary');
    });

    it('should create Dal instance without abstraction layer', () => {
      expect(dal).toBeDefined();
      expect(dal.tableName).toBeDefined();
      expect(dal.isAbstractionEnabled()).toBe(false);
    });

    it('should enable abstraction layer when environment variable is set', () => {
      process.env.USE_DATABASE_ABSTRACTION = 'true';
      const dalWithAbstraction = new Dal('primary');
      
      // Note: This might fail if provider creation fails, which is expected in test environment
      // The important thing is that it attempts to use abstraction
      expect(dalWithAbstraction).toBeDefined();
      
      // Clean up
      delete process.env.USE_DATABASE_ABSTRACTION;
    });

    it('should have abstraction methods available', () => {
      expect(typeof dal.isAbstractionEnabled).toBe('function');
      expect(typeof dal.getAbstractionProvider).toBe('function');
      expect(typeof dal.enableAbstraction).toBe('function');
      expect(typeof dal.disableAbstraction).toBe('function');
    });
  });

  describe('Enhanced DalBaseClass', () => {
    let dalBase: DalBaseClass;

    beforeEach(() => {
      dalBase = new DalBaseClass();
    });

    it('should create DalBaseClass instance', () => {
      expect(dalBase).toBeDefined();
      expect(dalBase['primary']).toBeDefined();
      expect(dalBase['data']).toBeDefined();
    });

    it('should have static provider management methods', () => {
      expect(typeof DalBaseClass.initializeProvider).toBe('function');
      expect(typeof DalBaseClass.getGlobalProvider).toBe('function');
      expect(typeof DalBaseClass.switchProvider).toBe('function');
    });

    it('should have abstraction layer methods', () => {
      expect(typeof dalBase['isAbstractionEnabled']).toBe('function');
      expect(typeof dalBase['getAbstractionProvider']).toBe('function');
    });
  });

  describe('CompatibleDal Class', () => {
    let compatibleDal: CompatibleDal;

    beforeEach(() => {
      compatibleDal = new CompatibleDal('primary');
    });

    it('should create CompatibleDal instance', () => {
      expect(compatibleDal).toBeDefined();
      expect(compatibleDal.tableName).toBeDefined();
    });

    it('should have Dal-like interface', () => {
      // CompatibleDal uses composition instead of inheritance
      expect(compatibleDal.tableName).toBeDefined();
      expect(typeof compatibleDal.query).toBe('function');
      expect(typeof compatibleDal.get).toBe('function');
      expect(typeof compatibleDal.put).toBe('function');
    });

    it('should have compatibility methods', () => {
      expect(typeof compatibleDal.enableAbstraction).toBe('function');
      expect(typeof compatibleDal.disableAbstraction).toBe('function');
      expect(typeof compatibleDal.isAbstractionEnabled).toBe('function');
      expect(typeof compatibleDal.getProvider).toBe('function');
    });

    it('should support all legacy DAL methods', () => {
      expect(typeof compatibleDal.query).toBe('function');
      expect(typeof compatibleDal.get).toBe('function');
      expect(typeof compatibleDal.put).toBe('function');
      expect(typeof compatibleDal.update).toBe('function');
      expect(typeof compatibleDal.delete).toBe('function');
      expect(typeof compatibleDal.batchGet).toBe('function');
      expect(typeof compatibleDal.scan).toBe('function');
      expect(typeof compatibleDal.send).toBe('function');
    });
  });

  describe('CompatibleDalBaseClass', () => {
    let compatibleDalBase: CompatibleDalBaseClass;

    beforeEach(() => {
      compatibleDalBase = new CompatibleDalBaseClass();
    });

    it('should create CompatibleDalBaseClass instance', () => {
      expect(compatibleDalBase).toBeDefined();
      expect(compatibleDalBase['primary']).toBeInstanceOf(CompatibleDal);
      expect(compatibleDalBase['data']).toBeInstanceOf(CompatibleDal);
    });

    it('should have static initialization methods', () => {
      expect(typeof CompatibleDalBaseClass.initialize).toBe('function');
    });

    it('should have provider management methods', () => {
      expect(typeof compatibleDalBase.enableAbstraction).toBe('function');
      expect(typeof compatibleDalBase.disableAbstraction).toBe('function');
      expect(typeof compatibleDalBase.isAbstractionEnabled).toBe('function');
      expect(typeof compatibleDalBase.getProvider).toBe('function');
      expect(typeof compatibleDalBase.switchProvider).toBe('function');
    });
  });

  describe('AbstractedDal Class', () => {
    it('should fail gracefully when provider is not available', () => {
      // AbstractedDal should throw ConfigurationError when DynamoDB provider is not implemented
      expect(() => {
        new AbstractedDal('primary');
      }).toThrow('Failed to initialize database provider');
    });

    it('should have static provider management methods', () => {
      expect(typeof AbstractedDal.setGlobalProvider).toBe('function');
      expect(typeof AbstractedDal.initializeFromConfig).toBe('function');
    });
  });

  describe('AbstractedDalBaseClass', () => {
    it('should fail gracefully when provider is not available', () => {
      // AbstractedDalBaseClass should throw ConfigurationError when DynamoDB provider is not implemented
      expect(() => {
        new AbstractedDalBaseClass();
      }).toThrow('Failed to initialize database provider');
    });

    it('should have static initialization method', () => {
      expect(typeof AbstractedDalBaseClass.initialize).toBe('function');
    });
  });

  describe('Environment Variable Integration', () => {
    afterEach(() => {
      // Clean up environment variables
      delete process.env.USE_DATABASE_ABSTRACTION;
      delete process.env.DATABASE_PROVIDER;
    });

    it('should respect USE_DATABASE_ABSTRACTION environment variable', () => {
      process.env.USE_DATABASE_ABSTRACTION = 'true';
      
      const dal = new CompatibleDal('primary');
      // Note: This might not actually enable abstraction due to provider creation failure
      // but it should attempt to use it
      expect(dal).toBeDefined();
    });

    it('should respect DATABASE_PROVIDER environment variable', () => {
      process.env.DATABASE_PROVIDER = 'mongodb';
      
      const dal = new Dal('primary');
      expect(dal).toBeDefined();
    });
  });

  describe('Backward Compatibility', () => {
    it('should maintain interface compatibility with legacy Dal', () => {
      const legacyDal = new Dal('primary');
      const compatibleDal = new CompatibleDal('primary');

      // CompatibleDal should have all the essential DAL methods
      const essentialMethods = ['query', 'get', 'put', 'update', 'delete', 'batchGet', 'scan', 'send'];
      
      essentialMethods.forEach(method => {
        expect(typeof legacyDal[method]).toBe('function');
        expect(typeof compatibleDal[method]).toBe('function');
      });

      // Both should have tableName property
      expect(legacyDal.tableName).toBeDefined();
      expect(compatibleDal.tableName).toBeDefined();
    });

    it('should maintain interface compatibility with legacy DalBaseClass', () => {
      const legacyDalBase = new DalBaseClass();
      const compatibleDalBase = new CompatibleDalBaseClass();

      // Both should have primary and data properties
      expect(legacyDalBase['primary']).toBeDefined();
      expect(legacyDalBase['data']).toBeDefined();
      expect(compatibleDalBase['primary']).toBeDefined();
      expect(compatibleDalBase['data']).toBeDefined();
    });
  });

  describe('Error Handling', () => {
    it('should handle provider creation failures gracefully', () => {
      // This should not throw even if provider creation fails
      expect(() => {
        const dal = new CompatibleDal('primary', true);
        return dal;
      }).not.toThrow();
    });

    it('should handle missing configuration gracefully', () => {
      // AbstractedDal should throw a specific error when provider is not available
      expect(() => {
        const dal = new AbstractedDal('primary');
        return dal;
      }).toThrow('Failed to initialize database provider');
    });
  });
});

// Mock tests for actual database operations (would need real database setup)
describe('DAL Operation Tests (Mocked)', () => {
  let mockProvider: any;

  beforeEach(() => {
    mockProvider = {
      get: jest.fn(),
      put: jest.fn(),
      update: jest.fn(),
      delete: jest.fn(),
      query: jest.fn(),
      scan: jest.fn(),
      batchGet: jest.fn(),
      executeNative: jest.fn(),
      isConnected: jest.fn().mockReturnValue(true),
      getProviderType: jest.fn().mockReturnValue('dynamodb')
    };
  });

  it('should handle abstraction layer enablement gracefully', async () => {
    const dal = new CompatibleDal('primary');
    
    // enableAbstraction should not throw, but should fail gracefully
    expect(() => {
      dal.enableAbstraction();
    }).not.toThrow();
    
    // Should fall back to not using abstraction
    expect(dal.isAbstractionEnabled()).toBe(false);
  });
});