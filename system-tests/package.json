{
    "name": "mytaptrack-tests-integration",
    "version": "1.0.1",
    "scripts": {
        "start": "npm test",
        "pretest": "rm -rf logs",
        "test": "jest",
        "test:local": "USE_LOCAL=true jest",
        "test:aws": "USE_LOCAL=false && node src/aws-test-setup.js && USE_LOCAL=false jest",
        "clean": "npx ts-node ./src/clean.ts",
        "presetDebug": "npm uninstall @mytaptrack/types",
        "setDebug": "npm i ../types",
        "unsetDebug": "npm uninstall @mytaptrack/types && npm i @mytaptrack/types --save",
        "set-env-vars": "node set-env-vars.js",
        "test:env": "npm run set-env-vars && npm test",
        "envSetup": "npx ts-node src/test-env-setup.ts",
        "genConfigs": "npx ts-node src/gen-configs.ts"
    },
    "dependencies": {
        "@aws-sdk/client-cognito-identity-provider": "^3.799.0",
        "@aws-sdk/credential-provider-sso": "^3.840.0",
        "@babel/plugin-transform-modules-commonjs": "^7.27.1",
        "@mytaptrack/cdk": "file:../cdk",
        "@mytaptrack/lib": "file:../lib",
        "@mytaptrack/types": "file:../types",
        "@types/moment": "^2.11.29",
        "aws-sdk": "^2.1692.0",
        "dotenv": "^17.2.3",
        "graphql": "^16.11.0",
        "graphql-request": "^6.1.0",
        "ioredis": "^5.8.2",
        "jsonschema": "^1.5.0",
        "jsonwebtoken": "^9.0.3",
        "moment": "^2.30.1",
        "moment-timezone": "^0.6.0",
        "short-uuid": "^5.2.0"
    },
    "devDependencies": {
        "@aws-sdk/client-ssm": "^3.799.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^16.10.3",
        "jest": "^29.7.0",
        "ts-jest": "^29.3.2",
        "typescript": "^5.0.4",
        "yaml": "^2.8.0"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "./jest-environment.js",
        "testMatch": [
            "**/src/tests/**/*.spec.ts"
        ],
        "testTimeout": 120000,
        "globalSetup": "<rootDir>/src/local-global-setup.js",
        "setupFilesAfterEnv": [
            "<rootDir>/src/jest.setup.ts"
        ]
    }
}
