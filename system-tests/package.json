{
    "name": "mytaptrack-tests-integration",
    "version": "1.0.1",
    "scripts": {
        "start": "npm test",
        "pretest": "rm -rf logs",
        "test": "jest",
        "test:container": "npm run configure:containers && jest",
        "test:container:dev": "npm run configure:containers:dev && jest",
        "test:container:test": "npm run configure:containers:test && jest",
        "test:container:prod": "npm run configure:containers:prod && jest",
        "test:container:watch": "npm run configure:containers && jest --watch",
        "test:container:health": "npm run configure:containers && jest --testNamePattern=\"Container Health\"",
        "test:aws": "npm run configure:aws && npm run set-env-vars && npm test",
        "configure:containers": "npx ts-node src/configure-containers.ts dev",
        "configure:containers:dev": "npx ts-node src/configure-containers.ts dev",
        "configure:containers:test": "npx ts-node src/configure-containers.ts test",
        "configure:containers:prod": "npx ts-node src/configure-containers.ts prod",
        "configure:aws": "npx ts-node src/configure-aws.ts",
        "clean": "npx ts-node ./src/clean.ts",
        "presetDebug": "npm uninstall @mytaptrack/types",
        "setDebug": "npm i ../types",
        "unsetDebug": "npm uninstall @mytaptrack/types && npm i @mytaptrack/types --save",
        "set-env-vars": "node set-env-vars.js",
        "test:env": "npm run set-env-vars && npm test",
        "envSetup": "npx ts-node src/test-env-setup.ts",
        "genConfigs": "npx ts-node src/gen-configs.ts"
    },
    "dependencies": {
        "@aws-sdk/client-cognito-identity-provider": "^3.799.0",
        "@aws-sdk/credential-provider-sso": "^3.840.0",
        "@babel/plugin-transform-modules-commonjs": "^7.27.1",
        "@mytaptrack/cdk": "file:../cdk",
        "@mytaptrack/lib": "file:../lib",
        "@mytaptrack/types": "^2.0.45",
        "aws-sdk": "^2.1692.0",
        "dotenv": "^17.2.3",
        "graphql": "^16.11.0",
        "graphql-request": "^6.1.0",
        "short-uuid": "^5.2.0"
    },
    "devDependencies": {
        "@aws-sdk/client-ssm": "^3.799.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^16.10.3",
        "jest": "^29.7.0",
        "ts-jest": "^29.3.2",
        "typescript": "^5.0.4",
        "yaml": "^2.8.0"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
            "**/src/tests/**/*.spec.ts"
        ],
        "testTimeout": 120000,
        "setupFilesAfterEnv": [
            "<rootDir>/src/jest.setup.ts"
        ]
    }
}
